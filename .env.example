# Docker Compose reads this file; native processes need exported environment.
# No Telegram/SMTP credentials belong in Stock Tracker.
STOCK_DB=/app/data/stock_tracker.db
DISPLAY_TIMEZONE=Asia/Shanghai
# S&P 500 + Nasdaq-100 + personal entries + four fixed benchmarks.
INDEX_UNIVERSE_ENABLED=true
COOKIE_SECURE=true
PUBLIC_URL=https://stocks.example.com
# Public hub base URL (do not append /api/v1/notify).
NOTIFICATION_API_URL=https://notify.watchpoint.space
# Set privately on the Stock Tracker server; must match notification-hub API_TOKEN.
NOTIFICATION_API_TOKEN=
# Spaces yfinance history calls (each may perform multiple HTTP requests).
YAHOO_MIN_INTERVAL_SECONDS=5
# Stop the entire run on rate limiting; persist a six-hour pause across restarts.
YAHOO_COOLDOWN_SECONDS=21600
# Market update schedule remains in SQLite: python -m lib.cli update-schedule --time 04:00
# Notifications run ONLY via a separate system timer; no app notify-worker.
# Path used by scripts.send_daily_report (private JSON is not committed).
DAILY_REPORT_CONFIG=/etc/stock-tracker/daily-report.json
